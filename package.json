{
  "name": "400-diary",
  "type": "module",
  "scripts": {
    "copy:wasm": "mkdir -p public/static && cp node_modules/@resvg/resvg-wasm/index_bg.wasm public/static/resvg_bg.wasm",
    "predev": "npm run copy:wasm",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run copy:wasm",
    "build": "npm run typecheck && rm -rf dist && vite build --mode client && vite build",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler pages deploy dist --commit-message=\"$(git rev-parse --short HEAD)\"",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "db:migrate:local": "wrangler d1 migrations apply 400-diary-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply 400-diary-db --remote"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "@resvg/resvg-wasm": "^2.6.2",
    "fflate": "^0.8.3",
    "hono": "^4.7.0",
    "honox": "^0.1.0",
    "nanoid": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@cloudflare/workers-types": "^4.20260214.0",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.25.0",
    "typescript": "5.9.3",
    "vite": "^6.2.0",
    "vite-plugin-full-reload": "^1.2.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.0.0"
  }
}
