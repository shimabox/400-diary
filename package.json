{
  "name": "400-diary",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && rm -rf dist && vite build --mode client && vite build",
    "deploy": "npm run build && wrangler pages deploy dist",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "db:migrate:local": "wrangler d1 execute 400-diary-db --local --file=db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute 400-diary-db --remote --file=db/schema.sql"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "hono": "^4.7.0",
    "honox": "^0.1.0",
    "nanoid": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@cloudflare/workers-types": "^4.20260214.0",
    "@hono/vite-cloudflare-pages": "^0.4.0",
    "@hono/vite-dev-server": "^0.25.0",
    "vite": "^6.2.0",
    "vite-plugin-full-reload": "^1.2.0",
    "wrangler": "^4.0.0"
  }
}
